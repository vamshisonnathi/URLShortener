# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Public base used to build shortUrl in responses (no trailing slash).
SHORT_URL_BASE=http://localhost:3000

# --- PostgreSQL (Prisma) ---
# In docker-compose the host is `postgres`; for local runs use `localhost`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener?schema=public

# --- Redis ---
# In docker-compose the host is `redis`; for local runs use `localhost`.
REDIS_URL=redis://localhost:6379

# --- Cache ---
# TTL (seconds) for code->url read-through cache entries.
CACHE_TTL_SECONDS=3600

# --- Rate limit (Redis token bucket, per IP, on POST /api/shorten) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=1
